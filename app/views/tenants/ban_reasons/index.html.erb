<article class="layout-center">
  <section class="content-section">
    <%= render 'shared/back_button', url: tenant_reports_path(tenant_slug: current_tenant.identifier) %>
    <h2><%= t('title.index', resource: BanReason.model_name.human) %></h2>

    <div class="actions">
      <%= link_to t('action.create'),
                  new_tenant_ban_reason_path(tenant_slug: current_tenant.identifier),
                  class: 'btn btn-primary' %>
    </div>

    <section class="ban-reasons-section">
      <h3><%= t('.system_reasons') %></h3>
      <table class="table">
        <thead>
          <tr>
            <th><%= BanReason.human_attribute_name(:name) %></th>
            <th><%= BanReason.human_attribute_name(:description) %></th>
            <th><%= BanReason.human_attribute_name(:active) %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @system_reasons.each do |ban_reason| %>
            <tr>
              <td><%= ban_reason.display_name %></td>
              <td><%= ban_reason.display_description %></td>
              <td><%= t("active_status.#{ban_reason.active? ? 'active' : 'inactive'}") %></td>
              <td class="action-buttons">
                <%= link_to t('action.edit'),
                            edit_tenant_ban_reason_path(tenant_slug: current_tenant.identifier, id: ban_reason.id),
                            class: 'btn btn-small' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <section class="ban-reasons-section">
      <h3><%= t('.custom_reasons') %></h3>
      <% if @custom_reasons.any? %>
        <table class="table">
          <thead>
            <tr>
              <th><%= BanReason.human_attribute_name(:name) %></th>
              <th><%= BanReason.human_attribute_name(:description) %></th>
              <th><%= BanReason.human_attribute_name(:active) %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @custom_reasons.each do |ban_reason| %>
              <tr>
                <td><%= ban_reason.display_name %></td>
                <td><%= ban_reason.display_description %></td>
                <td><%= t("active_status.#{ban_reason.active? ? 'active' : 'inactive'}") %></td>
                <td class="action-buttons">
                  <%= link_to t('action.edit'),
                              edit_tenant_ban_reason_path(tenant_slug: current_tenant.identifier, id: ban_reason.id),
                              class: 'btn btn-small' %>
                  <% if ban_reason.deletable? %>
                    <%= button_to t('action.delete'),
                                  tenant_ban_reason_path(tenant_slug: current_tenant.identifier, id: ban_reason.id),
                                  method: :delete,
                                  data: { turbo_confirm: t('.confirm_destroy') },
                                  class: 'btn btn-small btn-danger' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p><%= t('.no_custom_reasons') %></p>
      <% end %>
    </section>
  </section>
</article>
