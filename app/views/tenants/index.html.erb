<div class="container">
  <div class="tenant-list-header">
    <h1 class="text-title"><%= t('.title') %></h1>
  </div>

  <% if @member_tenants_pagination.records.any? %>
    <div class="tenant-section">
      <h2 class="text-subtitle"><%= t('.member_tenants') %></h2>
      <div class="tenant-grid">
        <% @member_tenants_pagination.records.each do |tenant| %>
          <%= link_to tenant_path(tenant_slug: tenant.slug), class: "tenant-card card" do %>
            <div class="tenant-card-header">
              <h3 class="text-card-title">
                <%= tenant.name %>
              </h3>
            </div>

            <div class="tenant-card-body">
              <p class="text-body"><%= tenant.description %></p>
            </div>

            <div class="tenant-card-footer divider--light">
              <span class="text-caption">@<%= tenant.slug %></span>
            </div>
          <% end %>
        <% end %>
      </div>

      <%= render partial: 'shared/pagination', locals: { pagination: @member_tenants_pagination, page_param: :member_tenants_page, query_params: { no_member_tenants_page: params[:no_member_tenants_page], per: params[:per] }.compact } %>
    </div>
  <% end %>

  <% if @no_member_tenants_pagination.records.any? %>
    <div class="tenant-section">
      <% if user_signed_in? %>
        <h2 class="text-subtitle"><%= t('.no_member_tenants') %></h2>
      <% end %>
      <div class="tenant-grid">
        <% @no_member_tenants_pagination.records.each do |tenant| %>
          <%= link_to tenant_path(tenant_slug: tenant.slug), class: "tenant-card card" do %>
            <div class="tenant-card-header">
              <h3 class="text-card-title"><%= tenant.name %></h3>
            </div>

            <div class="tenant-card-body">
              <p class="text-body"><%= tenant.description %></p>
            </div>

            <div class="tenant-card-footer divider--light">
              <span class="text-caption">@<%= tenant.slug %></span>
            </div>
          <% end %>
        <% end %>
      </div>

      <%= render partial: 'shared/pagination', locals: { pagination: @no_member_tenants_pagination, page_param: :no_member_tenants_page, query_params: { member_tenants_page: params[:member_tenants_page], per: params[:per] }.compact } %>
    </div>
  <% end %>

  <% if @member_tenants_pagination.records.empty? && @no_member_tenants_pagination.records.empty? %>
    <div class="tenant-list-empty">
      <p><%= t('.no_tenants') %></p>
    </div>
  <% end %>
</div>
