<%= form_with model: report,
              url: tenant_reports_path(tenant_slug: current_tenant.identifier),
              method: :post do |f| %>
  <div id="report-form-errors"></div>

  <%= hidden_field_tag :from_topic_id, topic.id %>
  <%= hidden_field_tag :reportable_type, report.reportable_type.downcase %>
  <%= hidden_field_tag :reportable_id, report.reportable_id %>

  <div class="form-group">
    <%= f.label :ban_reason_id, BanReason.model_name.human %>
    <%= f.select :ban_reason_id,
                current_tenant.ban_reasons.active_reasons.map { |br| [br.display_name, br.id] },
                { prompt: t('action.select') },
                { class: "form-control", required: true } %>
  </div>

  <div class="form-group">
    <%= f.label :reason_text %>
    <%= f.text_area :reason_text, rows: 5, class: "form-control", required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit t('action.settle'), class: "btn btn-primary" %>
    <button type="button" class="close-button" data-close-modal-target="closeButton"><%= t('action.close') %></button>
  </div>
<% end %>
