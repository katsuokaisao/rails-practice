<table class="reports-table">
    <thead>
    <tr>
        <th><%= t('activerecord.attributes.report.reporter') %></th>
        <th><%= t('activerecord.attributes.report.reason_type') %></th>
        <th><%= t('activerecord.attributes.report.reason_text') %></th>
        <th><%= t('activerecord.attributes.report.reportable_user') %></th>
        <th><%= t('activerecord.attributes.report.created_at') %></th>
        <th><%= t('.action') %></th>
    </tr>
    </thead>
    <tbody>
        <% pagination.records.each do |report| %>
            <tr>
                <td><%= report.reporter.login_id %></td>
                <td><%= report.reason_type %></td>
                <td><%= truncate(report.reason_text, length: 1000) %></td>
                <td><%= report.reportable.login_id %></td>
                <td><%= l(report.created_at, format: :default) %></td>
                <td>
                    <%= link_to Decision.model_name.human, new_tenant_decision_path(tenant_slug: current_tenant.slug, report_id: report.id, format: :turbo_stream), class: 'btn btn-sm btn-primary', data: { turbo_prefetch: false } %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
