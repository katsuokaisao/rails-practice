<div class="container">
  <div class="tenant-detail-header">
    <div class="tenant-detail-title-wrapper">
      <h1 class="text-title"><%= @tenant.name %></h1>
      <div class="tenant-detail-identifier-wrapper">
        <span class="text-caption">@<%= @tenant.slug %></span>
      </div>
    </div>
    <% if can_access?('tenants/invitations', 'new') %>
      <div class="tenant-detail-actions">
        <%= link_to t('.invite_member'),
                    new_tenant_invitation_path(tenant_slug: @tenant.slug),
                    class: "btn-link" %>
      </div>
    <% end %>
  </div>

  <div class="divider--thick"></div>

  <div class="tenant-detail-section">
    <h2 class="text-heading"><%= t('.description_title') %></h2>
    <div class="tenant-detail-description">
      <p class="text-body"><%= @tenant.description %></p>
    </div>
  </div>

  <div class="divider--thick"></div>

  <div class="topic-header">
    <h2><%= t('title.index', resource: Topic.model_name.human) %></h2>
    <% if can_access?('tenants/topics', 'new') %>
      <div class="topic-actions">
        <%= link_to t('.action.new'),
                    new_tenant_topic_path(tenant_slug: current_tenant.slug),
                    class: "btn-link" %>
      </div>
    <% end %>
  </div>

  <ul class="topics-list">
    <%= render partial: 'tenants/topics/item', collection: @pagination.records, as: :topic %>
  </ul>
  <%= render partial: 'shared/pagination', locals: { pagination: @pagination } %>

  <div class="tenant-detail-back divider">
    <%= link_to root_path, class: "text-link" do %>
      ← <%= t('.back_to_list') %>
    <% end %>
  </div>
</div>
