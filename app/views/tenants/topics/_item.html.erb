<li class="topic-item">
    <div>
        <%= link_to tenant_topic_path(tenant_slug: current_tenant.identifier, id: topic.id) do %>
            <h3>
              <%= topic.title %>
              <% if topic.locked? %>
                <span class="topic-status topic-status--locked">
                  🔒 <%= t('locked') %>
                </span>
              <% end %>
            </h3>
        <% end %>
        <div class="topic-details">
            <p><%= t('author') %> <%= display_name_with_id(topic.author) %></p>
            <p><%= t('created_at') %> <%= l(topic.created_at, format: :default) %></p>
            <p><%= t('comment_count') %> <%= topic.total_comment %><%= t('.count_suffix') %></p>
        </div>
    </div>
    <%= render partial: 'tenants/topics/edit_action', locals: { topic: topic } %>
</li>
