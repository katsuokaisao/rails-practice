<article class="layout-center">
  <section class="form-card">
    <%= render 'shared/back_button', url: root_path %>

    <h1><%= t('.title') %></h1>

    <p class="text-body"><%= t('.description') %></p>

    <% if @subscribed_memberships.any? %>
      <%= form_with url: unsubscription_path,
                    method: :post,
                    data: {
                      controller: "unsubscription",
                      action: "submit->unsubscription#confirmSubmit",
                      confirm_message: t('.confirm_message')
                    } do |f| %>

        <div class="policy-legend">
          <p class="legend-title"><%= t('.legend.title') %></p>
          <div class="legend-items">
            <div class="legend-section">
              <span class="legend-label"><%= t('.table.comment_policy') %></span>
              <ul>
                <li><%= t('.legend.comment.keep_visible') %></li>
                <li><%= t('.legend.comment.hide_content') %></li>
                <li><%= t('.legend.comment.delete') %></li>
              </ul>
            </div>
            <div class="legend-section">
              <span class="legend-label"><%= t('.table.topic_policy') %></span>
              <ul>
                <li><%= t('.legend.topic.keep_visible') %></li>
                <li><%= t('.legend.topic.lock') %></li>
                <li><%= t('.legend.topic.delete') %></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="unsubscription-controls">
          <button type="button"
                  class="btn btn-primary btn-sm"
                  data-action="click->unsubscription#selectAll">
            <%= t('.select_all') %>
          </button>
          <button type="button"
                  class="btn btn-secondary btn-sm"
                  data-action="click->unsubscription#deselectAll">
            <%= t('.deselect_all') %>
          </button>
        </div>

        <table class="table">
          <thead>
            <tr>
              <th></th>
              <th><%= t('.table.tenant') %></th>
              <th><%= t('.table.comment_policy') %></th>
              <th><%= t('.table.topic_policy') %></th>
            </tr>
          </thead>
          <tbody>
            <% @subscribed_memberships.each do |membership| %>
              <% policies = unsubscribed_user_policy_description(membership.tenant) %>
              <tr>
                <td>
                  <%= check_box_tag 'tenant_ids[]',
                                    membership.tenant_id,
                                    false,
                                    data: {
                                      unsubscription_target: "checkbox",
                                      action: "change->unsubscription#updateSubmitButton"
                                    },
                                    class: "tenant-checkbox" %>
                </td>
                <td><strong><%= membership.tenant.name %></strong></td>
                <td><%= policies[:comment] %></td>
                <td><%= policies[:topic] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="actions">
          <%= f.submit t('action.unsubscribe'),
                      class: "btn btn-danger",
                      data: { unsubscription_target: "submitButton" } %>
          <%= link_to t('action.cancel'), root_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-body"><%= t('.no_tenants') %></p>
      <%= link_to t('action.cancel'), root_path, class: "btn btn-secondary" %>
    <% end %>
  </section>
</article>
